# ============================================================
# Copy this file to .env and fill in the values.
# .env holds secrets: never commit it (keep it in .gitignore).
# Comments must start with '#', and values must not have inline comments.
# ============================================================


# ---- Application ----
APP_NAME=auth-starter


# ---- Swagger / OpenAPI docs ----
# true only in development: it publishes your API documentation
SWAGGER_ENABLED=false


# ---- Actuator ----
# Comma-separated endpoints to expose. Keep it to health,info in production.
EXPOSED_ENDPOINTS=health,info
# Actuator base path
BASE_URL=/actuator


# ---- Database (PostgreSQL) ----
DATABASE_URL=jdbc:postgresql://localhost:5432/auth_starter
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password

# Hibernate schema mode:
#   validate - checks the schema matches (default, use this in production)
#   update   - adds missing tables/columns (fine locally)
#   create   - DROPS and recreates every table: development only, wipes all data
DDL_AUTO=validate


# ---- CORS ----
# Comma-separated exact origins (no '*', the app refuses to start with it)
# Example: http://localhost:3000,https://your-domain.com
CORS_ORIGINS_ALLOWED=http://localhost:3000


# ---- JWT ----
# A Base64 string of at least 32 bytes. Generate one:
#   Windows PowerShell:
#     $b = New-Object byte[] 32; (New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b)
#   macOS / Linux:
#     openssl rand -base64 48
# Changing it later logs everyone out.
JWT_SECRET=replace_with_a_base64_secret

# ISO-8601 (PT15M, P7D) or short form (15m, 7d)
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P7D


# ---- Mail ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password

# Optional: sender address, for providers where the SMTP username is not a real
# address (e.g. SendGrid's "apikey"). Defaults to MAIL_USERNAME.
# APP_MAIL_FROM=no-reply@example.com

# Frontend URL used in email links (verification, password reset, email change)
MAIL_FRONTEND_URL=http://localhost:3000


# ---- Passkeys / WebAuthn ----
# Frontend origin(s) allowed for WebAuthn, comma-separated
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000

# Relying Party ID: the domain passkeys are bound to (no scheme or port)
# Local development: localhost
# Real domain: example.com
WEBAUTHN_RP_ID=localhost


# ---- Google Sign-In ----
# The OAuth client ID(s) your apps use. Several are allowed, comma-separated
# (one per platform: web, Android, iOS), because a token's audience must match one of them.
GOOGLE_CLIENT_ID=your_google_client_id
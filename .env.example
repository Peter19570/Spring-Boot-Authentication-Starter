# ============================================================
# Application
# ============================================================

APP_NAME=auth-starter


# ============================================================
# Actuator
# ============================================================

# Comma-separated list of endpoints to expose
EXPOSED_ENDPOINTS=health,info

# Actuator base path
BASE_URL=/actuator


# ============================================================
# Database (PostgreSQL)
# ============================================================

DATABASE_URL=jdbc:postgresql://localhost:5432/your_database
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password

# Examples: update, validate, create, create-drop, none
DDL_AUTO=validate


# ============================================================
# CORS
# ============================================================

# Comma-separated origins, without square brackets
# Example: http://localhost:3000,https://your-domain.com
CORS_ORIGINS_ALLOWED=http://localhost:3000


# ============================================================
# JWT
# ============================================================

# Generate a strong random secret for this
JWT_SECRET=your_jwt_secret

# Duration format depends on your application configuration
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d


# ============================================================
# Mail
# ============================================================

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password

# ============================================================
# Frontend URL used in email links
# ============================================================

MAIL_FRONTEND_URL=http://localhost:3000

# ============================================================
# Passkey / WebAuthn
# ============================================================

# Frontend origin(s) allowed for WebAuthn
# Example: http://localhost:3000
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000

# WebAuthn Relying Party ID
# For localhost development: localhost
# For a real domain: example.com
WEBAUTHN_RP_ID=localhost


# ============================================================
# Google ID Services
# ============================================================

GOOGLE_CLIENT_ID=your_google_client_id

